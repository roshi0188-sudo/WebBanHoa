@model WebBanHoa.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập - Floral LAM";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
    }

    .login-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    }

    /* 🌸 ĐỒNG BỘ MÀU BURGUNDY LUXURY ĐỘC QUYỀN */
    .btn-luxury-pink {
        background: linear-gradient(135deg, #DE8F9F, #834c58);
        color: white;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-luxury-pink:hover {
            opacity: 0.95;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(131, 76, 88, 0.2);
        }

    .text-luxury-pink {
        color: #834c58 !important;
    }

    .form-control:focus {
        border-color: #DE8F9F;
        box-shadow: 0 0 0 0.25rem rgba(131, 76, 88, 0.1);
    }
</style>

<div class="container mt-5 py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="login-card p-5">
                <div class="text-center mb-4">
                    <span class="display-5">🌸</span>
                    <h3 class="fw-bold text-dark" style="font-family: 'Playfair Display', serif;">Floral LAM</h3>
                    <p class="text-muted small">Chào mừng bạn quay trở lại shop hoa của LAM</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-medium"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary">Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0 bg-light shadow-none" placeholder="Nhập địa chỉ email..." required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control border-start-0 bg-light shadow-none" placeholder="Nhập mật khẩu..." required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="row align-items-center mb-4">
                        <div class="col-6">
                            <div class="form-check text-start m-0">
                                <input type="checkbox" name="rememberMe" id="rememberMeInput" value="true" class="form-check-input" style="cursor: pointer;" />
                                <input type="hidden" name="rememberMe" value="false" />
                                <label class="form-check-label small fw-semibold text-secondary user-select-none" for="rememberMeInput" style="cursor: pointer; padding-left: 4px; font-size: 13px;">
                                    Ghi nhớ
                                </label>
                            </div>
                        </div>
                        <div class="col-6 text-end">
                            <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none small fw-semibold" style="color: #834c58; font-size: 13px;">
                                Quên mật khẩu?
                            </a>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-luxury-pink w-100 py-2.5 rounded-pill fw-bold shadow-sm">
                        Đăng nhập 
                    </button>
                </form>

                <div class="text-center mt-4">
                    <p class="small text-muted mb-0">Chưa có tài khoản? <a asp-action="Register" class="text-decoration-none text-luxury-pink fw-semibold">Đăng ký ngay</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}