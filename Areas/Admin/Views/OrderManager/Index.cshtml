@model IEnumerable<WebBanHoa.Models.Order>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý duyệt đơn hoa";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
   

    /* 🌟 BỘ KHUNG HIỂN THỊ THIỆP  */
    .admin-inline-card-box {
        background-color: #FFF5F7;
        border: 1px dashed #DE8F9F;
        border-radius: 10px;
        padding: 8px 12px;
        margin-top: 2px;
        max-width: 280px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 2px 6px rgba(163, 72, 99, 0.03);
    }

    /* Hiệu ứng bo góc nhẹ cho ảnh phôi thiệp đính kèm */
    .admin-card-thumbnail {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #E2E8F0;
        background-color: white;
    }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold m-0 page-title" style="color: #2D141A;">Quản Lý Đơn Đặt Hoa</h3>
            <small class="text-muted">Phê duyệt, theo dõi luồng vận chuyển và hoàn thành các đơn hàng hoa tươi nghệ thuật</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Admin" asp-controller="OrderManager" asp-action="ExportToCsv" class="btn btn-success btn-admin-action shadow-sm text-decoration-none text-white">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Xuất dữ liệu CSV
            </a>
            <a asp-area="Admin" asp-controller="OrderManager" asp-action="RevenueDashboard" class="btn btn-primary btn-admin-action shadow-sm text-decoration-none text-white" style="background-color: #A34863; border-color: #A34863;">
                <i class="bi bi-graph-up-arrow me-1"></i> Dashboard doanh thu
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["DangerMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["DangerMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card p-3 mb-4 shadow-sm border-0 bg-white rounded-4 filter-btn-group">
        <form method="get" asp-area="Admin" asp-controller="OrderManager" asp-action="Index" class="d-flex flex-wrap gap-2 align-items-center">
            <span class="text-secondary small fw-bold me-2"><i class="bi bi-funnel-fill"></i> Bộ lọc trạng thái:</span>

            <a asp-action="Index" asp-route-statusFilter="" class="btn btn-sm btn-filter @(string.IsNullOrEmpty(ViewBag.CurrentFilter) ? "btn-dark text-white" : "btn-light border text-secondary")">Tất cả</a>
            <a asp-action="Index" asp-route-statusFilter="Chờ xử lý" class="btn btn-sm btn-filter @(ViewBag.CurrentFilter == "Chờ xử lý" ? "btn-warning text-white" : "btn-light border text-secondary")">⏳ Chờ xử lý</a>
            <a asp-action="Index" asp-route-statusFilter="Đang giao" class="btn btn-sm btn-filter @(ViewBag.CurrentFilter == "Đang giao" ? "btn-info text-white" : "btn-light border text-secondary")">🚚 Đang giao</a>
            <a asp-action="Index" asp-route-statusFilter="Đã hoàn thành" class="btn btn-sm btn-filter @(ViewBag.CurrentFilter == "Đã hoàn thành" ? "btn-success text-white" : "btn-light border text-secondary")">✅ Đã hoàn thành</a>
            <a asp-action="Index" asp-route-statusFilter="Đã hủy" class="btn btn-sm btn-filter @(ViewBag.CurrentFilter == "Đã hủy" ? "btn-danger text-white" : "btn-light border text-secondary")">❌ Đã hủy</a>
        </form>
    </div>

    <div class="card admin-order-card shadow-sm">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-admin-order align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th style="width: 10%;">Mã Đơn</th>
                            <th style="width: 12%;">Ngày Đặt</th>
                            <th style="width: 24%;">Thông Tin Khách Hàng</th>
                            <th style="width: 20%;">Sản Phẩm</th>
                            <th style="width: 25%;">Dịch vụ kèm</th>
                            <th style="width: 11%;">Tổng Tiền</th>
                            <th style="width: 10%;">Trạng Thái</th>
                            <th class="text-end" style="width: 13%;">Hành Động Duyệt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            string pillClass = "pill-pending";
                            string statusIcon = "bi-clock-history";

                            if (order.OrderStatus == "Đang giao" || order.OrderStatus == "Đang vận chuyển")
                            {
                                pillClass = "pill-shipping";
                                statusIcon = "bi-truck";
                            }
                            else if (order.OrderStatus == "Đã hoàn thành" || order.OrderStatus == "Đã giao")
                            {
                                pillClass = "pill-completed";
                                statusIcon = "bi-check2-circle";
                            }
                            else if (order.OrderStatus == "Đã hủy")
                            {
                                pillClass = "pill-canceled";
                                statusIcon = "bi-x-circle";
                            }

                            <tr>
                                <td class="fw-bold" style="color: #A34863;">#LAM-@order.Id</td>
                                <td class="text-muted small">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="fw-bold text-dark mb-1">
                                        <i class="bi bi-person-fill text-muted me-1"></i> Tặng: @order.ReceiverName
                                    </div>
                                    <small class="text-muted d-block" style="font-size: 11px;">(Người mua: @(order.User?.FullName ?? "Ẩn danh"))</small>
                                    <div class="text-secondary small fw-semibold">
                                        <i class="bi bi-telephone text-muted me-1"></i> @order.PhoneNumber
                                    </div>
                                    <small class="text-muted d-block text-truncate mt-1" style="max-width: 200px;" title="@order.ShippingAddress">
                                        <i class="bi bi-geo-alt text-muted"></i> @order.ShippingAddress
                                    </small>
                                </td>
                                <td>
                                    <div class="d-flex flex-column align-items-start gap-1">
                                        @foreach (var detail in order.OrderDetails)
                                        {
                                            <span class="mini-product-tag">
                                                🌸 @(detail.Product?.Name ?? "Mẫu hoa hệ thống")
                                                <span class="quantity-badge">x@(detail.Quantity)</span>
                                            </span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(order.CardContent))
                                    {
                                        <div class="admin-inline-card-box">
                                            <img src="@order.CardImage" class="admin-card-thumbnail" onerror="this.src='https://placehold.co/50x50?text=Card'">
                                            <div style="flex: 1; min-width: 0;">
                                                <small class="d-block fw-bold text-uppercase" style="font-size: 9px; color: #A34863; letter-spacing: 0.3px;">
                                                    <i class="bi bi-envelope-heart-fill"></i> Lời chúc viết thiệp:
                                                </small>
                                                <p class="m-0 text-dark small fw-semibold lh-sm mt-0.5" style="font-style: italic; font-size: 12px; white-space: normal; word-break: break-word;">
                                                    "@order.CardContent"
                                                </p>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fs-7" style="font-style: italic;">Không kèm thiệp</span>
                                    }
                                </td>

                                <td class="fw-bold" style="color: #A34863; font-size: 15px;">@order.TotalAmount.ToString("#,##0") đ</td>
                                <td>
                                    <span class="status-pill @pillClass">
                                        <i class="bi @statusIcon"></i> @order.OrderStatus
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        @if (order.OrderStatus == "Chờ xử lý")
                                        {
                                            <form asp-area="Admin" asp-controller="OrderManager" asp-action="ApproveOrder" asp-route-orderId="@order.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-admin-action shadow-sm text-white" style="background-color: #A34863; border-color: #A34863;">
                                                    Duyệt
                                                </button>
                                            </form>

                                            <form asp-area="Admin" asp-controller="OrderManager" asp-action="CancelOrder" asp-route-orderId="@order.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn đặt hoa này không?');" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger btn-admin-action">
                                                    Hủy
                                                </button>
                                            </form>
                                        }
                                        else if (order.OrderStatus == "Đang giao")
                                        {
                                            <form asp-area="Admin" asp-controller="OrderManager" asp-action="CompleteOrder" asp-route-orderId="@order.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-primary btn-admin-action shadow-sm text-white" style="background-color: #A34863; border-color: #A34863;">
                                                    <i class="bi bi-patch-check-fill me-1"></i> Xong
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small style-card-text" style="font-style: italic;">Đã xử lý</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-3 text-muted mb-3 d-block" style="color: #E8CAD4 !important;"></i>
                <h5 class="fw-semibold text-secondary">Hệ thống chưa ghi nhận đơn đặt hoa nào phù hợp bộ lọc này.</h5>
            </div>
        }
    </div>
</div>