<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Floral LAM Admin</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
            * {
                box-sizing: border-box;
                font-family: 'Plus Jakarta Sans', sans-serif;
            }

            body {
                margin: 0;
                padding: 0;
                background-color: #F8F9FA;
            }

            /* THANH SIDEBAR BÊN TRÁI - ĐÃ FIX CHỐNG ĐƠ */
            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background-color: #FFFFFF;
                border-right: 1px solid #E2E8F0;
                padding: 32px 24px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                z-index: 9999 !important; /* Đẩy hẳn lên trên cùng */
                pointer-events: auto !important; /* Mở khóa tương tác chuột */
            }

            .logo-section h4 {
                color: #A34863;
                font-weight: 700;
                margin-bottom: 40px;
            }

            .nav-menu {
                list-style: none;
                padding: 0;
                margin: 0;
                flex-grow: 1;
            }

            .nav-menu-item {
                margin-bottom: 12px;
            }

            .nav-menu-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #4A5568;
                text-decoration: none;
                font-weight: 500;
                border-radius: 12px;
                transition: 0.3s;
            }

                .nav-menu-link:hover {
                    background-color: #FFF0F5;
                    color: #A34863;
                    font-weight: 600;
                }

            /* KHỐI NỘI DUNG BÊN PHẢI - CHỪA CHỖ CHO SIDEBAR */
            .main-container {
                margin-left: 260px;
                padding: 40px;
                min-height: 100vh;
                position: relative;
                z-index: 1;
            }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="w-100">
            <div class="logo-section">
                <h4>🌸 Floral LAM</h4>
            </div>
            <ul class="nav-menu">
                <li class="nav-menu-item">
                    <a class="nav-menu-link" href="/Admin/Dashboard">
                        <i class="bi bi-grid-1x2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-menu-item">
                    <a class="nav-menu-link" href="/Admin/ProductManager">
                        <i class="bi bi-box-seam"></i> Quản lý sản phẩm
                    </a>
                </li>
                <li class="nav-menu-item">
                    <a class="nav-menu-link" href="/Admin/Category">
                        <i class="bi bi-tags"></i> Quản lý danh mục
                    </a>
                </li>
                <li class="nav-menu-item">
                    <a class="nav-link text-dark d-flex align-items-center gap-2" asp-area="Admin" asp-controller="OrderManager" asp-action="Index">
                        <i class="bi bi-tags"></i> Quản lý đơn
                    </a>
                </li>
            </ul>
        </div>

        <div class="logout-section">
            <a href="/" class="nav-menu-link text-danger">
                <i class="bi bi-box-arrow-left"></i> Về trang chủ
            </a>
        </div>
    </div>

    <div class="main-container">
        @RenderBody()
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>