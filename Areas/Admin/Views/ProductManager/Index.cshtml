@model IEnumerable<WebBanHoa.Models.Product>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý sản phẩm - Floral LAM Admin";
    var categories = ViewBag.Categories as List<WebBanHoa.Models.Category>;
    var currentCategory = ViewBag.CurrentCategory as int?;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<div class="d-flex justify-content-between align-items-center mb-4 pb-2">
    <div>
        <h3 class="fw-extrabold m-0 text-dark" style="font-size: 28px; letter-spacing: -0.5px;">Quản Lý Danh Sách Hoa</h3>
        <small class="text-muted fw-medium">Hệ thống phân phối và vận hành danh sách sản phẩm.</small>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4 col-sm-6">
        <div class="stat-card-luxury d-flex align-items-center justify-content-between shadow-sm">
            <div>
                <small class="text-uppercase text-muted fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Tổng Mẫu Hoa Lưu Trữ</small>
                <h3 class="fw-extrabold my-1 text-dark" style="font-size: 30px;">@(Model?.Count() ?? 0)</h3>
                <small class="text-success fw-bold"><i class="bi bi-shield-check-fill"></i> Dữ liệu sẵn sàng</small>
            </div>
            <div class="stat-icon-box"><i class="bi bi-flower2"></i></div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 bg-white p-3 rounded-4 shadow-sm border" style="border-color: #FAF4F6 !important;">
    <div class="d-flex align-items-center gap-2">
        <span class="text-uppercase text-muted fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Lọc:</span>

        <select class="form-select filter-select-premium w-auto"
                onchange="window.location.href='?categoryId=' + this.value">
            <option value="">-- Tất cả danh mục hoa --</option>
            @if (categories != null)
            {
                foreach (var cat in categories)
                {
                    <!option value="@cat.Id" @(currentCategory == cat.Id ? "selected" : "")>
                        🌸 @cat.Name
                    </!option>
                }
            }
        </select>
    </div>

    <a asp-area="Admin" asp-controller="ProductManager" asp-action="Create" class="btn btn-add-product-luxury gap-2 shadow-sm text-uppercase">
        <i class="bi bi-plus-lg-fill"></i> Thêm sản phẩm mới
    </a>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 admin-product-card p-3 shadow-sm">

                    <div class="position-relative overflow-hidden rounded-4" style="aspect-ratio: 3/4; background-color: #FDFBFC;">
                        <span class="badge-stock-premium">Còn Hàng</span>

                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default_flower.jpg" : item.ImageUrl)"
                             class="w-100 h-100 object-fit-cover d-block"
                             onerror="this.src='https://placehold.co/400x500?text=Floral+LAM'">

                        <div class="admin-action-overlay">
                            <div class="d-grid gap-2.5 w-75">
                                <a asp-area="Admin" asp-controller="ProductManager" asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-dark rounded-pill fw-bold py-2" style="font-size: 12.5px;">
                                    <i class="bi bi-eye-fill me-1"></i> Xem chi tiết
                                </a>

                                <a asp-area="Admin" asp-controller="ProductManager" asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-dark rounded-pill fw-bold py-2" style="border-color: #A34863; color: #A34863; font-size: 12.5px; background-color: #FFF5F7;">
                                    <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa hoa
                                </a>

                                <a asp-area="Admin" asp-controller="ProductManager" asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger rounded-pill fw-bold py-2" style="font-size: 12.5px;">
                                    <i class="bi bi-trash3-fill me-1"></i> Xóa mẫu hoa
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body px-1 pt-3 pb-0 d-flex flex-column justify-content-between">
                        <div>
                            <h6 class="fw-bold mb-1 text-dark text-truncate fs-6" title="@item.Name">@item.Name</h6>

                            <div class="mb-2">
                                @if (item.Category != null)
                                {
                                    <small class="text-secondary fw-semibold" style="font-size:12.5px;">
                                        <i class="bi bi-tag-fill me-1" style="color: #DE8F9F;"></i> Chủ đề: @item.Category.Name
                                    </small>
                                }
                                else
                                {
                                    <small class="text-muted fw-medium" style="font-size:12.5px;">
                                        <i class="bi bi-tag me-1"></i> Chưa phân loại
                                    </small>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top" style="border-top-color: #FFF5F7 !important;">
                            <span class="product-price-admin">
                                @item.Price.ToString("#,##0") <span style="font-size: 12px; font-weight: 700;">đ</span>
                            </span>
                            <small class="text-muted fw-bold bg-light px-2 py-0.5 rounded" style="font-size: 10px; letter-spacing: 0.5px;">ID: @item.Id</small>
                        </div>
                    </div>

                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="card border-0 shadow-sm p-5 bg-white rounded-4 border" style="border-color: #FAF4F6 !important;">
                <i class="bi bi-inboxes display-3 opacity-50 mb-3" style="color: #A34863;"></i>
                <h5 class="fw-bold text-dark">Kho lưu trữ hoa trống hoặc không tìm thấy</h5>
                <p class="text-muted small mx-auto" style="max-width: 400px;">Vui lòng chọn bộ lọc khác hoặc bổ sung mẫu hoa mới lên sàn hệ thống ngay lập tức.</p>
                <div class="mt-2">
                    <a href="/Admin/ProductManager" class="btn btn-sm btn-outline-secondary rounded-pill px-4 fw-bold">Đặt lại bộ lọc</a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // JS chặn sủi bọt sự kiện click trên các nút hành động của thẻ
        document.querySelectorAll('.admin-action-overlay a').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        });

        // Tương thích lật menu overlay mượt cho thiết bị cảm ứng máy tính bảng/điện thoại
        document.querySelectorAll('.admin-product-card').forEach(card => {
            card.addEventListener('click', function (e) {
                if (e.target.closest('a')) return;
                const isActive = this.classList.contains('active');
                document.querySelectorAll('.admin-product-card').forEach(c => c.classList.remove('active'));
                if (!isActive) { this.classList.add('active'); }
            });
        });
    </script>
}