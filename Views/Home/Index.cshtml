@model IEnumerable<WebBanHoa.Models.Product>

@{
    ViewData["Title"] = "Trang chủ - Floral LAM";
    var categories = ViewBag.Categories as List<WebBanHoa.Models.Category>;
    var currentCategory = ViewBag.CurrentCategory as int?;
    var currentSearch = ViewBag.CurrentSearch as string;

    // Lấy đúng 3 mẫu hoa từ Model để dàn trang theo thiết kế mới
    var featuredProducts = Model != null ? Model.Take(3).ToList() : new List<WebBanHoa.Models.Product>();
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<style>
    *, h1, h2, h3, h4, h5, h6, .btn, p, span, small {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
    }

    body {
        background-color: #ffffff;
    }

    .hero-container {
        background: radial-gradient(circle at 80% 50%, #F5EAEF 0%, #FDFBFC 100%);
        min-height: 600px;
        display: flex;
        align-items: center;
    }

    .hero-title {
        font-size: 52px;
        font-weight: 800;
        line-height: 1.2;
        color: #111111;
        letter-spacing: -1.5px;
    }

    .btn-luxury-dark {
        background-color: #E6B941;
        color: #111111 !important;
        font-weight: 700;
        padding: 14px 32px;
        border-radius: 30px;
        transition: all 0.3s ease;
        border: none;
        font-size: 13px;
        letter-spacing: 0.5px;
        text-decoration: none;
    }

        .btn-luxury-dark:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(230, 185, 65, 0.25);
        }

    .btn-luxury-outline {
        background: transparent;
        color: #111111 !important;
        border: 1.5px solid #EAE1E4;
        font-weight: 700;
        padding: 14px 32px;
        border-radius: 30px;
        transition: all 0.3s ease;
        font-size: 13px;
        letter-spacing: 0.5px;
        text-decoration: none;
    }

        .btn-luxury-outline:hover {
            border-color: #111111;
            background-color: #111111;
            color: white !important;
        }

    .occasion-circle-wrapper {
        text-align: center;
        text-decoration: none !important;
        display: block;
        transition: transform 0.3s ease;
    }

        .occasion-circle-wrapper:hover {
            transform: translateY(-5px);
        }

    .occasion-img {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        margin-bottom: 12px;
        transition: all 0.3s;
        border: 2px solid transparent;
    }

    .occasion-circle-wrapper:hover .occasion-img {
        border-color: #DE8F9F;
        box-shadow: 0 12px 30px rgba(163, 72, 99, 0.12);
    }

    .occasion-title {
        font-size: 12px;
        font-weight: 700;
        color: #4A5568;
        letter-spacing: 0.3px;
    }

    .collection-banner-box {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        cursor: pointer;
    }

    .collection-overlay-content {
        position: absolute;
        bottom: 30px;
        left: 30px;
        z-index: 10;
        color: white;
    }

    .bestseller-card {
        border: none;
        background: transparent;
        transition: all 0.3s ease;
    }

    .bestseller-img-container {
        border-radius: 20px;
        overflow: hidden;
        aspect-ratio: 3/4;
        background-color: #F7F7F7;
        position: relative;
    }

    .bestseller-img {
        width: 100px;
        height: 100px;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .bestseller-card:hover .bestseller-img {
        transform: scale(1.04);
    }

    .product-badge-premium {
        position: absolute;
        top: 15px;
        left: 15px;
        background: #E6B941;
        color: #111111;
        font-size: 10px;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 20px;
        text-uppercase: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-add-to-cart-luxury {
        border: 1px solid #F5E6EC;
        background-color: white;
        color: #A34863;
        font-size: 12px;
        font-weight: 700;
        padding: 11px 0;
        border-radius: 12px;
        width: 100%;
        transition: all 0.25s;
        text-decoration: none;
        display: block;
    }

        .btn-add-to-cart-luxury:hover {
            border-color: #A34863;
            color: white;
            background-color: #A34863;
        }

    .service-benefit-box {
        background-color: #FFF5F7;
        border-radius: 16px;
        padding: 25px;
        height: 100%;
        transition: transform 0.3s;
    }

        .service-benefit-box:hover {
            transform: translateY(-3px);
        }

    .footer-newsletter-zone {
        background-color: #6B4E5B; 
        border-radius: 24px;
        padding: 60px;
        color: white;
    }

    .newsletter-input {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        color: white;
        padding: 14px 24px;
        border-radius: 30px;
        font-size: 14px;
    }

        .newsletter-input::placeholder {
            color: rgba(255,255,255,0.4);
        }

        .newsletter-input:focus {
            background: rgba(255,255,255,0.15);
            border-color: rgba(255,255,255,0.3);
            box-shadow: none;
            color: white;
        }
</style>

<div class="hero-container position-relative overflow-hidden w-100 mb-5">
    <div class="container py-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h1 class="hero-title mb-4">
                    Gửi Gắm Yêu Thương<br />Qua Từng Bó Hoa
                </h1>
                <p class="text-secondary mb-5 fs-6 lh-relaxed" style="max-width: 480px; font-weight: 500;">
                    Trải nghiệm những mẫu thiết kế hoa tươi tinh tế cùng các bộ sưu tập độc quyền theo mùa, được thực hiện thủ công cho những khoảnh khắc vô giá của bạn.
                </p>
                <div class="d-flex gap-3">
                    <a href="#bestsellers-zone" class="btn btn-luxury-dark text-uppercase">Mua Ngay</a>
                    <a href="#collections-zone" class="btn btn-luxury-outline text-uppercase">Khám Phá Bộ Sưu Tập</a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="/images/banner.jpg" class="img-fluid" style="max-height: 480px;" alt="Floral Art" onerror="this.src='https://placehold.co/600x480?text=Premium+Bouquet'">
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS Khung lưới đồng bộ tuyệt đối */
    .custom-collection-grid {
        display: flex;
        gap: 24px;
        height: 520px; /* Chốt cứng chiều cao tổng để ảnh không bao giờ bị ép dẹp */
    }

    .collection-left-panel {
        flex: 1;
        border-radius: 20px;
        position: relative;
        overflow: hidden;
    }

    .collection-right-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .collection-right-top {
        flex: 1;
        border-radius: 20px;
        position: relative;
        overflow: hidden;
    }

    .collection-right-bottom {
        flex: 1;
        display: flex;
        gap: 24px;
    }

    .collection-right-bottom-item {
        flex: 1;
        border-radius: 20px;
        position: relative;
        overflow: hidden;
    }

    /* Thuộc tính ép ảnh luôn cắt cúp đẹp, không méo */
    .collection-img-cover {
        width: 100%;
        height: 100%;
        object-fit: cover !important;
        display: block;
        transition: transform 0.5s ease;
    }

    /* Hiệu ứng zoom nhẹ khi trỏ chuột */
    .collection-left-panel:hover .collection-img-cover,
    .collection-right-top:hover .collection-img-cover,
    .collection-right-bottom-item:hover .collection-img-cover {
        transform: scale(1.05);
    }

    .collection-text-overlay {
        position: absolute;
        left: 0;
        width: 100%;
        padding: 30px;
        z-index: 2;
    }

    .overlay-bottom {
        bottom: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
    }

    .overlay-top {
        top: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
    }

    /* Responsive cho điện thoại (tự động xếp dọc) */
    @@media (max-width: 768px) {
        .custom-collection-grid {
            flex-direction: column;
            height: auto;
        }

        .collection-left-panel {
            height: 400px;
        }

        .collection-right-top, .collection-right-bottom-item {
            height: 220px;
        }
    }
</style>

<div class="container my-5 py-4" id="collections-zone">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <small class="text-uppercase tracking-wider text-muted fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Thiết Kế Độc Quyền</small>
            <h3 class="fw-bold m-0 mt-1 text-dark" style="letter-spacing: -0.5px;">Bộ Sưu Tập Theo Mùa</h3>
        </div>
       
    </div>

    <div class="custom-collection-grid">

        <div class="collection-left-panel shadow-sm">
            <img src="~/images/mau1.jpg" class="collection-img-cover" alt="Rực rỡ" />
            <div class="collection-text-overlay overlay-bottom">
                <h4 class="fw-bold text-white mb-1">Rực rỡ</h4>
                <p class="small text-white-50 mb-0">Sắc màu pastel tươi mới và khởi đầu rực rỡ</p>
            </div>
        </div>

        <div class="collection-right-panel">

            <div class="collection-right-top shadow-sm">
                <img src="~/images/mau2.jpg" class="collection-img-cover" alt="Dịu dàng" />
                <div class="collection-text-overlay overlay-top">
                    <h4 class="fw-bold text-white m-0">Dịu dàng</h4>
                </div>
            </div>

            <div class="collection-right-bottom">
                <div class="collection-right-bottom-item shadow-sm">
                    <img src="~/images/mau3.jpg" class="collection-img-cover" alt="Tối giản" />
                </div>
                <div class="collection-right-bottom-item shadow-sm">
                    <img src="~/images/mau4.jpg" class="collection-img-cover" alt="Học trò" />
                </div>
            </div>

        </div>
    </div>
</div>

<div class="container my-5 py-4" id="bestsellers-zone">
    <div class="text-center mb-5">
        <h3 class="fw-bold text-dark mb-2" style="letter-spacing: -0.5px; font-size: 28px;">Sản Phẩm Hoa Tươi Nổi Bật</h3>
        <p class="text-muted small">Những giỏ hoa nghệ thuật ngẫu nhiên nhận được sự yêu thích nhất từ khách hàng của Floral LAM.</p>
    </div>

    <div class="row g-4 justify-content-center">
        @if (featuredProducts.Any())
        {
            foreach (var item in featuredProducts)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 bestseller-card d-flex flex-column justify-content-between">
                        <div>
                            <div class="bestseller-img-container mb-3">
                                <span class="product-badge-premium">Mẫu Bán Chạy</span>
                                <a asp-controller="Home" asp-action="Display" asp-route-id="@item.Id">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default_flower.jpg" : item.ImageUrl)"
                                         class="w-100 h-100 object-fit-cover bestseller-img" alt="@item.Name" />
                                </a>
                            </div>
                            <div class="d-flex justify-content-between align-items-start px-1">
                                <h6 class="fw-bold text-dark text-truncate m-0" style="max-width: 240px; font-size: 16px;">@item.Name</h6>
                                <span class="text-muted small fw-semibold flex-shrink-0"><i class="bi bi-star-fill text-warning me-1"></i>4.9</span>
                            </div>
                            <div class="px-1 mt-1 mb-3">
                                <span class="text-secondary fw-bold" style="color: #A34863; font-size: 15px;">@item.Price.ToString("#,##0") đ</span>
                            </div>
                        </div>
                        <div class="px-1">
                            <a asp-controller="Home" asp-action="Display" asp-route-id="@item.Id" class="btn btn-add-to-cart-luxury text-center text-uppercase">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">Hệ thống đang đồng bộ danh sách sản phẩm nghệ thuật.</div>
        }
    </div>
</div>
<div class="container my-5">
    <div class="row g-3 justify-content-center">
        <!-- Voucher 1 -->
        <div class="col-md-6 col-lg-5">
            <div class="p-3 border border-2 border-dashed rounded-4 d-flex align-items-center justify-content-between" style="background-color: #FFF5F7; border-color: #DE8F9F !important;">
                <div class="d-flex align-items-center">
                    <i class="bi bi-tag-fill fs-3 me-3" style="color: #A34863;"></i>
                    <div>
                        <h6 class="fw-bold mb-0" style="font-size: 14px; color: #2D141A;">GIẢM 20% ĐƠN ĐẦU TIÊN</h6>
                        <small class="text-muted">Mã: <strong id="voucherCode1" style="color: #A34863;">LAM2026</strong></small>
                    </div>
                </div>
                <button class="btn btn-outline-dark btn-sm rounded-pill px-3" style="font-size: 12px; font-weight: 600;" onclick="copyVoucherToClipboard('voucherCode1')">Sao chép</button>
            </div>
        </div>

        <!-- Voucher 2 -->
        <div class="col-md-6 col-lg-5">
            <div class="p-3 border border-2 border-dashed rounded-4 d-flex align-items-center justify-content-between" style="background-color: #FFF5F7; border-color: #DE8F9F !important;">
                <div class="d-flex align-items-center">
                    <i class="bi bi-gift-fill fs-3 me-3" style="color: #A34863;"></i>
                    <div>
                        <h6 class="fw-bold mb-0" style="font-size: 14px; color: #2D141A;">ƯU ĐÃI ĐỘC QUYỀN KHÁCH MỚI</h6>
                        <small class="text-muted">Mã: <strong id="voucherCode2" style="color: #A34863;">LAMFLORAL</strong></small>
                    </div>
                </div>
                <button class="btn btn-outline-dark btn-sm rounded-pill px-3" style="font-size: 12px; font-weight: 600;" onclick="copyVoucherToClipboard('voucherCode1')">Sao chép</button>
            </div>
        </div>
    </div>
</div>
<div class="container my-5 py-4">
    <div class="row g-4">
        <div class="col-6 col-lg-3">
            <div class="service-benefit-box text-center text-sm-start">
                <i class="bi bi-truck fs-3 text-dark d-block mb-2" style="color: #A34863;"></i>
                <h6 class="fw-bold text-dark mb-1" style="font-size: 14px;">Giao Hoa 2 Giờ</h6>
                <p class="text-muted m-0" style="font-size: 12px; line-height: 1.5;">Giao hỏa tốc nội thành, bảo đảm trạng thái hoa hoàn hảo nhất.</p>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="service-benefit-box text-center text-sm-start">
                <i class="bi bi-flower1 fs-3 text-dark d-block mb-2" style="color: #A34863;"></i>
                <h6 class="fw-bold text-dark mb-1" style="font-size: 14px;">Hoa Tươi Mỗi Ngày</h6>
                <p class="text-muted m-0" style="font-size: 12px; line-height: 1.5;">Hoa nhập mới từ nông trại hữu cơ Đà Lạt vào mỗi sáng sớm.</p>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="service-benefit-box text-center text-sm-start">
                <i class="bi bi-camera fs-3 text-dark d-block mb-2" style="color: #A34863;"></i>
                <h6 class="fw-bold text-dark mb-1" style="font-size: 14px;">Gửi Ảnh Thực Tế</h6>
                <p class="text-muted m-0" style="font-size: 12px; line-height: 1.5;">Chụp thành phẩm thực tế tại cửa hàng gửi khách duyệt trước khi đi giao.</p>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="service-benefit-box text-center text-sm-start">
                <i class="bi bi-shield-lock fs-3 text-dark d-block mb-2" style="color: #A34863;"></i>
                <h6 class="fw-bold text-dark mb-1" style="font-size: 14px;">Thanh Toán An Toàn</h6>
                <p class="text-muted m-0" style="font-size: 12px; line-height: 1.5;">Mã mã hóa bảo mật tuyệt đối cho mọi giao dịch điện tử ngân hàng.</p>
            </div>
        </div>
    </div>
</div>