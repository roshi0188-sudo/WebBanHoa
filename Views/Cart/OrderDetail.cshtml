@model WebBanHoa.Models.Order
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Chi tiết hóa đơn mua hoa - Floral LAM";

  
    int activeStepIndex = Model.OrderStatus switch
    {
        "Chờ xử lý" => 1,
        "Đã xác nhận" => 1,
        "Đang giao" => 2,
        "Đã gửi hàng" => 2,
        "Đã giao" => 4,
        "Đã hoàn thành" => 4,
        _ => 1
    };
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    /* Đồng bộ font chữ cao cấp Plus Jakarta Sans cho toàn trang */
    *, h5, h6, th, td, .timeline-node-label, strong, span, p {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
    }

    body {
        background-color: #FCF9FA;
    }

    .luxury-detail-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #F5E6EC;
        box-shadow: 0 15px 35px rgba(163, 72, 99, 0.02);
    }

    /* 🌟 BỘ KHUNG TIMELINE TRẠNG THÁI GIAO HÀNG TRỰC QUAN THEO YÊU CẦU BẮT BUỘC */
    .timeline-container {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin: 40px 0;
        padding-top: 10px;
    }

        /* Đường kẻ xám chạy nền đằng sau */
        .timeline-container::before {
            content: '';
            position: absolute;
            top: 28px;
            left: 6%;
            width: 88%;
            height: 4px;
            background-color: #E2E8F0;
            z-index: 1;
        }

    /* Thanh màu hồng chạy sáng tiến trình thời gian thực */
    .timeline-progress-line {
        position: absolute;
        top: 28px;
        left: 6%;
        height: 4px;
        background: linear-gradient(90deg, #DE8F9F, #A34863);
        z-index: 2;
        transition: width 0.4s ease;
        width: @((activeStepIndex - 1) * 29.3) %; /* Tính toán tự động tỷ lệ co giãn */
    }

    .timeline-node {
        text-align: center;
        position: relative;
        z-index: 3;
        width: 25%;
    }

    .timeline-node-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #E2E8F0;
        color: #718096;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px auto;
        font-size: 15px;
        transition: all 0.3s ease;
        border: 4px solid white;
    }

    /* Định dạng CSS thắp sáng mốc đang xử lý và mốc đã hoàn thành */
    .timeline-node.active .timeline-node-circle {
        background-color: #A34863;
        color: white;
        box-shadow: 0 0 0 5px rgba(163, 72, 99, 0.15);
    }

    .timeline-node.completed .timeline-node-circle {
        background-color: #DE8F9F;
        color: white;
    }

    .timeline-node-label {
        font-size: 13px;
        font-weight: 500;
        color: #718096;
    }

    .timeline-node.active .timeline-node-label {
        color: #A34863;
        font-weight: 700;
    }

    /* Khung hiển thị thiệp Premium chúc mừng */
    .gift-card-preview-box {
        background-color: #FFF5F7;
        border: 1px dashed #DE8F9F;
        border-radius: 16px;
    }
</style>

<div class="container mt-5 py-4" style="max-width: 850px;">
    <div class="card luxury-detail-card shadow-sm p-4">

        <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid #FAF4F6;">
            <h5 class="fw-bold m-0" style="color: #2D141A;">
                <i class="bi bi-receipt-cutoff me-2" style="color:#A34863;"></i> Chi tiết đơn đặt hoa #LAM-@Model.Id
            </h5>
            <a asp-action="OrderHistory" class="btn btn-sm btn-outline-secondary rounded-pill px-3 text-decoration-none">
                <i class="bi bi-arrow-left"></i> Quay lại lịch sử
            </a>
        </div>

        <div class="timeline-container">
            <div class="timeline-progress-line"></div>

            <div class="timeline-node @(activeStepIndex >= 1 ? (activeStepIndex == 1 ? "active" : "completed") : "")">
                <div class="timeline-node-circle"><i class="bi bi-shield-check"></i></div>
                <div class="timeline-node-label">Đã xác nhận</div>
            </div>

            <div class="timeline-node @(activeStepIndex >= 2 ? (activeStepIndex == 2 ? "active" : "completed") : "")">
                <div class="timeline-node-circle"><i class="bi bi-box-seam"></i></div>
                <div class="timeline-node-label">Đang vận chuyển</div>
            </div>
   

            <div class="timeline-node @(activeStepIndex == 3 ? "active" : "")">
                <div class="timeline-node-circle"><i class="bi bi-house-heart"></i></div>
                <div class="timeline-node-label">Đã giao</div>
            </div>
        </div>

        <div class="row g-3 rounded-4 p-3 mb-4 mt-2 small text-secondary" style="background-color: #FFF8F9; border: 1px solid #FCECEF;">
            <div class="col-sm-6">
                <span class="d-block mb-2">
                    <strong class="text-dark"><i class="bi bi-person-fill text-muted me-1"></i> Người nhận hoa:</strong>
                    <span class="text-dark fw-bold text-uppercase">@Model.ReceiverName</span>
                </span>
                <span class="d-block mb-2"><strong class="text-dark"><i class="bi bi-calendar-event text-muted me-1"></i> Thời gian đặt mua:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                <span><strong class="text-dark"><i class="bi bi-telephone text-muted me-1"></i> Số điện thoại nhận:</strong> @Model.PhoneNumber</span>
            </div>
            <div class="col-sm-6">
                <span><strong class="text-dark"><i class="bi bi-geo-alt text-muted me-1"></i> Địa chỉ bàn giao chi tiết:</strong> @Model.ShippingAddress</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.CardContent))
        {
            <div class="gift-card-preview-box p-4 mb-4">
                <h6 class="fw-bold mb-3" style="color: #A34863;"><i class="bi bi-envelope-heart-fill me-1"></i> Quà tặng kèm: Thiệp chúc mừng nghệ thuật</h6>
                <div class="row g-3 align-items-center">
                    <div class="col-sm-3 text-center text-sm-start">
                        <span class="fw-bold text-secondary d-block mb-2" style="font-size: 11px; letter-spacing: 0.5px;">PHÔI THIỆP ĐÃ CHỌN:</span>
                        <img src="@Model.CardImage" class="rounded-3 border shadow-sm object-fit-cover" style="width: 110px; height: 110px;" onerror="this.src='https://placehold.co/110x110?text=Mau+Thiep'">
                    </div>
                    <div class="col-sm-9">
                        <div class="bg-white p-3 rounded-3 border" style="border-color: #F3EAEF !important; min-height: 90px;">
                            <span class="fw-bold text-uppercase d-block mb-1 text-muted" style="font-size: 10px; letter-spacing: 0.5px;">Thông điệp chữ viết tay:</span>
                            <p class="m-0 fw-semibold text-dark lh-base" style="font-size: 14px; font-style: italic; color: #2D141A !important;">
                                "@Model.CardContent"
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }

        <h6 class="fw-bold text-dark mb-3">Danh sách mẫu hoa nghệ thuật</h6>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-secondary small" style="border-bottom: 2px solid #FAF4F6;">
                        <th>Mẫu hoa tươi</th>
                        <th class="text-center" style="width: 100px;">Số lượng</th>
                        <th class="text-end" style="width: 130px;">Đơn giá lẻ</th>
                        <th class="text-end" style="width: 140px;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        foreach (var item in Model.OrderDetails)
                        {
                            <tr style="border-bottom: 1px solid #F3EAEF;">
                                <td class="fw-bold text-dark">🌸 @(item.Product?.Name ?? "Mẫu hoa tươi nghệ thuật")</td>
                                <td class="text-center fw-semibold text-secondary">x@(item.Quantity)</td>
                                <td class="text-end text-muted">@item.Price.ToString("#,##0") đ</td>
                                <td class="text-end fw-bold text-dark">@((item.Price * item.Quantity).ToString("#,##0")) đ</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted small py-3">Không tìm thấy thông tin chi tiết sản phẩm.</td>
                        </tr>
                    }
                    <tr class="border-0">
                        <td colspan="2" class="border-0"></td>
                        <td class="text-end fw-bold text-secondary border-0">Tổng thanh toán đơn:</td>
                        <td class="text-end fw-bold fs-4 border-0" style="color: #A34863;">@Model.TotalAmount.ToString("#,##0") đ</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
</div>