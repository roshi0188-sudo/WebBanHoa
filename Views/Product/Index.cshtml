@model IEnumerable<WebBanHoa.Models.Product>

@{
    ViewData["Title"] = "Bộ Sưu Tập - Floral LAM";
    var categories = ViewBag.Categories as List<WebBanHoa.Models.Category>;
    var currentCategory = ViewBag.CurrentCategory as int?;
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentSort = ViewBag.CurrentSort as string ?? "newest";

    // Bốc các thông tin phân trang thật từ Controller gửi ra
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&display=swap" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<style>
    *, h1, h2, h3, h4, h5, h6, p, span, small, a, input, select {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
    }

    body {
        background-color: #FDFBFC;
    }

    .page-header-title {
        color: #2D141A;
        font-size: 40px;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .filter-section-title {
        font-size: 11px;
        font-weight: 800;
        color: #8C96A3;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    /* CUSTOM RADIO BUTTON */
    .custom-radio-wrapper {
        display: flex;
        align-items: center;
        margin-bottom: 14px;
        cursor: pointer;
        position: relative;
    }

        .custom-radio-wrapper input[type="radio"] {
            appearance: none;
            -webkit-appearance: none;
            width: 18px;
            height: 18px;
            border: 2px solid #E2E8F0;
            border-radius: 50%;
            margin-right: 12px;
            position: relative;
            cursor: pointer;
            transition: all 0.2s ease;
            background-color: #FFF;
        }

            .custom-radio-wrapper input[type="radio"]:checked {
                border-color: #A34863;
                background-color: #A34863;
            }

                .custom-radio-wrapper input[type="radio"]:checked::after {
                    content: '';
                    position: absolute;
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background-color: white;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                }

        .custom-radio-wrapper label {
            font-size: 14px;
            color: #4A5568;
            cursor: pointer;
            font-weight: 500;
            transition: color 0.2s ease;
            width: 100%;
        }

        .custom-radio-wrapper:hover label {
            color: #A34863;
        }

    /* PREMIUM CONTROLS */
    .search-wrapper-premium {
        position: relative;
        max-width: 320px;
        width: 100%;
    }

    .search-input-premium {
        width: 100%;
        background-color: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 30px;
        padding: 10px 16px 10px 42px;
        font-size: 13.5px;
        transition: all 0.3s ease;
    }

        .search-input-premium:focus {
            border-color: #DE8F9F;
            box-shadow: 0 0 0 4px rgba(222, 143, 159, 0.12);
            outline: none;
        }

    .search-icon-inside {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #A0AEC0;
        font-size: 14px;
    }

    .sort-select-premium {
        border: 1px solid #E2E8F0 !important;
        background-color: #FFFFFF !important;
        border-radius: 30px !important;
        font-weight: 600;
        color: #2D141A;
        font-size: 13.5px;
        padding: 8px 36px 8px 16px !important;
        cursor: pointer;
        box-shadow: none !important;
    }

    /* LUXURY PRODUCT CARD */
    .product-card-luxury {
        text-decoration: none !important;
        display: block;
        background: #FFFFFF;
        border-radius: 20px;
        padding: 12px;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(0,0,0,0.02);
    }

        .product-card-luxury:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(163, 72, 99, 0.06) !important;
            border-color: rgba(163, 72, 99, 0.08);
        }

    .product-img-wrapper {
        border-radius: 14px;
        overflow: hidden;
        aspect-ratio: 1/1; /* Chuyển sang tỉ lệ vuông 1:1 thời thượng, đổi thành 3/4 tùy sở thích */
        background-color: #FAF8F9;
        position: relative;
        margin-bottom: 16px;
    }

    .product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .product-card-luxury:hover .product-img {
        transform: scale(1.06);
    }

    .badge-premium {
        position: absolute;
        top: 12px;
        left: 12px;
        font-size: 9px;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 30px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        z-index: 2;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .badge-pink {
        background-color: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(4px);
        color: #A34863;
        border: 1px solid rgba(163, 72, 99, 0.1);
    }

    .product-title {
        font-size: 15px;
        font-weight: 600;
        color: #2D3748;
        line-height: 1.4;
        transition: color 0.2s ease;
    }

    .product-card-luxury:hover .product-title {
        color: #A34863;
    }

    .product-price {
        font-size: 16px;
        font-weight: 700;
        color: #A34863;
    }

    .product-category-italic {
        font-size: 12px;
        color: #A0AEC0;
        margin-top: 2px;
    }

    /* RANGE SLIDER SIMULATOR */
    .price-slider-track {
        height: 4px;
        background-color: #EDF2F7;
        width: 100%;
        border-radius: 2px;
        position: relative;
    }

    .price-slider-range {
        height: 4px;
        background-color: #A34863;
        width: 70%;
        position: absolute;
        top: 0;
        left: 10%;
        border-radius: 2px;
    }

    .price-slider-handle {
        width: 14px;
        height: 14px;
        background-color: #FFFFFF;
        border: 2px solid #A34863;
        border-radius: 50%;
        position: absolute;
        top: -5px;
        cursor: pointer;
    }

    /* PAGINATION PREMIUM */
    .pagination-luxury .page-link {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50% !important;
        border: 1px solid #E2E8F0;
        color: #4A5568;
        font-weight: 600;
        font-size: 13.5px;
        margin: 0 4px;
        background: #FFFFFF;
        transition: all 0.25s ease;
        text-decoration: none;
    }

        .pagination-luxury .page-link.active {
            background-color: #A34863 !important;
            border-color: #A34863 !important;
            color: white !important;
            box-shadow: 0 4px 12px rgba(163, 72, 99, 0.25);
        }

        .pagination-luxury .page-link:hover:not(.active) {
            background-color: #FAF4F6;
            border-color: #DE8F9F;
            color: #A34863;
        }
</style>

<div class="container my-5 py-2">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <h2 class="page-header-title mb-2">Bộ Sưu Tập Hoa</h2>
        <p class="text-muted small mx-auto" style="max-width: 500px; font-weight: 500; font-size: 14px;">
            Khám phá những giỏ hoa được tuyển chọn kỹ lưỡng cho những khoảnh khắc quý giá nhất trong cuộc sống.
        </p>
    </div>

    <!-- Toolbar: Search & Sort -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom border-light">
        <!-- Search bar -->
        <form method="get" action="/Product" class="search-wrapper-premium">
            <input type="hidden" name="categoryId" value="@currentCategory" />
            <input type="hidden" name="sortOrder" value="@currentSort" />
            <i class="bi bi-search search-icon-inside"></i>
            <input type="text" name="searchString" class="search-input-premium" placeholder="Tìm kiếm mẫu hoa..." value="@currentSearch">
        </form>

        <!-- Sort dropdown -->
        <div class="d-flex align-items-center justify-content-end gap-2">
            <span class="text-uppercase text-muted fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">Sắp xếp:</span>
            <select class="form-select sort-select-premium w-auto"
                    onchange="window.location.href='?searchString=@currentSearch&categoryId=@currentCategory&sortOrder=' + this.value">
                <!option value="newest" @(currentSort == "newest" ? "selected" : "")>Mới nhất</!option>
                <!option value="price_asc" @(currentSort == "price_asc" ? "selected" : "")>Giá: Thấp đến Cao</!option>
                <!option value="price_desc" @(currentSort == "price_desc" ? "selected" : "")>Giá: Cao đến Thấp</!option>
            </select>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Filter (Desktop) -->
        <div class="col-lg-3 d-none d-lg-block">
            <div class="card border-0 bg-transparent pe-3">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold m-0 text-dark" style="font-size: 16px;">Bộ lọc sản phẩm</h5>
                    <a href="/Product" class="text-muted small text-decoration-none fw-semibold hover-underline" style="font-size: 13px; color: #A34863 !important;">Xóa tất cả</a>
                </div>

                <!-- Categories filter -->
                <div class="mb-5">
                    <div class="filter-section-title">CHỦ ĐỀ HOA</div>

                    <div class="custom-radio-wrapper">
                        <input type="radio" id="cat_all" name="filterCategory" value="" @(currentCategory == null ? "checked" : "")
                               onclick="window.location.href='/Product?searchString=@currentSearch&sortOrder=@currentSort'">
                        <label for="cat_all">Tất cả bộ sưu tập</label>
                    </div>

                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            <div class="custom-radio-wrapper">
                                <input type="radio" id="cat_@cat.Id" name="filterCategory" value="@cat.Id" @(currentCategory == cat.Id ? "checked" : "")
                                       onclick="window.location.href='?categoryId=@cat.Id&searchString=@currentSearch&sortOrder=@currentSort'">
                                <label for="cat_@cat.Id">@cat.Name</label>
                            </div>
                        }
                    }
                </div>
                
            </div>
        </div>

        <!-- Product Grid Column -->
        <div class="col-lg-9">
            <!-- Mobile Category Badges (Hiển thị nhanh trên Điện thoại khi mất Sidebar) -->
            <div class="d-lg-none d-flex gap-2 overflow-x-auto pb-3 mb-3 compliance-scroll" style="white-space: nowrap; -webkit-overflow-scrolling: touch;">
                <a href="/Product?searchString=@currentSearch&sortOrder=@currentSort"
                   class="btn btn-sm px-3 rounded-pill @(currentCategory == null ? "btn-dark" : "btn-outline-secondary")" style="font-size: 13px;">Tất cả</a>
                @if (categories != null)
                {
                    foreach (var cat in categories)
                    {
                        <a href="?categoryId=@cat.Id&searchString=@currentSearch&sortOrder=@currentSort"
                           class="btn btn-sm px-3 rounded-pill @(currentCategory == cat.Id ? "btn-dark" : "btn-outline-secondary")" style="font-size: 13px;">@cat.Name</a>
                    }
                }
            </div>

            <!-- Grid Items -->
            <div class="row g-4 mb-5">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="col-6 col-md-4">
                            <a asp-controller="Product" asp-action="Display" asp-route-id="@item.Id" class="product-card-luxury h-100 d-flex flex-column">
                                <div class="product-img-wrapper">
                                    <span class="badge-premium badge-pink">Floral LAM</span>
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default_flower.jpg" : item.ImageUrl)"
                                         class="product-img" alt="@item.Name" loading="lazy">
                                </div>

                                <div class="flex-grow-1 d-flex flex-column justify-content-between px-1">
                                    <div>
                                        <h3 class="product-title m-0 text-truncate">@item.Name</h3>
                                        <p class="product-category-italic text-truncate m-0">
                                            @(item.Category?.Name ?? "Hoa nghệ thuật")
                                        </p>
                                    </div>
                                    <div class="mt-2">
                                        <span class="product-price">
                                            @item.Price.ToString("#,##0") đ
                                        </span>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5 my-4">
                        <i class="bi bi-flower3 display-3 text-muted opacity-50"></i>
                        <h5 class="fw-bold text-dark mt-4">Không tìm thấy mẫu hoa phù hợp</h5>
                        <p class="text-muted small">Vui lòng thử tìm kiếm từ khóa khác hoặc xóa bộ lọc.</p>
                        <a href="/Product" class="btn text-white px-4 py-2 mt-2 rounded-pill fw-bold btn-sm shadow-sm" style="background-color: #A34863;">Xóa bộ lọc</a>
                    </div>
                }
            </div>

            <!-- Premium Pagination -->
            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-center pt-3 border-top border-light">
                    <div class="pagination-luxury d-flex align-items-center">

                        @if (currentPage > 1)
                        {
                            <a href="?page=@(currentPage - 1)&categoryId=@currentCategory&searchString=@currentSearch&sortOrder=@currentSort" class="page-link">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        }

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <a href="?page=@i&categoryId=@currentCategory&searchString=@currentSearch&sortOrder=@currentSort"
                               class="page-link @(i == currentPage ? "active" : "")">
                                @i
                            </a>
                        }

                        @if (currentPage < totalPages)
                        {
                            <a href="?page=@(currentPage + 1)&categoryId=@currentCategory&searchString=@currentSearch&sortOrder=@currentSort" class="page-link">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        }
                    </div>
                </div>
            }

        </div>
    </div>
</div>