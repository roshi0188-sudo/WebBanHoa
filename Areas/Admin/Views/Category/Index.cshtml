@model IEnumerable<WebBanHoa.Models.Category>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý danh mục hoa";
}

<div class="container-fluid mt-2">
    <div class="admin-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-5">
        <div>
            <h3 class="text-dark fw-bold m-0" style="font-family: 'Montserrat', sans-serif;">
                Quản lý danh mục
            </h3>
            <small class="text-muted" style="font-size: 13px;">Quản lý các nhóm phân loại hoa hiển thị trên hệ thống cửa hàng</small>
        </div>
        <a asp-area="Admin" asp-controller="Category" asp-action="Add" class="btn btn-add-category-luxury d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> Thêm danh mục
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var cat in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm custom-card-hash position-relative overflow-hidden">

                        <div class="position-absolute top-0 end-0 rounded-bl-4 fw-bold border-start border-bottom">
                            ID: #@cat.Id
                        </div>

                        <div class="card-body p-4 d-flex flex-column justify-content-between" style="min-height: 170px;">
                            <div class="pe-5 mb-3">
                                <span class="text-muted d-block small text-uppercase fw-bold mb-2" style="letter-spacing: 0.5px; font-size: 11px; color: #DE8F9F !important;">Floral Category</span>
                                <h5 class="card-title fw-bold text-dark m-0" style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px;">@cat.Name</h5>
                            </div>

                            <div class="d-flex gap-2 border-top pt-3 bg-transparent">
                                <a asp-area="Admin" asp-controller="Category" asp-action="Update" asp-route-id="@cat.Id"
                                   class="btn btn-sm btn-action-edit w-100 rounded-pill py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-pencil"></i> Chỉnh sửa
                                </a>
                                <a asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@cat.Id"
                                   class="btn btn-sm btn-action-delete w-100 rounded-pill py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-trash3"></i> Xoá danh mục
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 border-0 shadow-sm bg-white mt-4" style="border-radius: 24px;">
            <i class="bi bi-folder2-open display-4 d-block mb-3" style="color: #DE8F9F;"></i>
            <h5 class="fw-bold text-secondary">Hệ thống chưa có danh mục hoa nào</h5>
            <p class="text-muted small m-0 mt-1">Hãy bấm nút "Thêm danh mục" ở góc trên để bổ sung dữ liệu.</p>
        </div>
    }
</div>