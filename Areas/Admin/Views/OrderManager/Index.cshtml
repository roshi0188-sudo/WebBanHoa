@model IEnumerable<WebBanHoa.Models.Order>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; // Kế thừa khung quản trị của bạn
    ViewData["Title"] = "Quản lý duyệt đơn hoa";
}

<style>
    .admin-order-card {
        background: white;
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        padding: 25px;
    }

    .table-admin-order th {
        background-color: #F8FAFC;
        color: #64748B;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        padding: 14px;
        border: none;
    }

    .table-admin-order td {
        padding: 16px 14px;
        vertical-align: middle;
        font-size: 14px;
        border-bottom: 1px solid #F1F5F9;
    }

    .status-pill {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .pill-pending {
        background-color: #FEFCBF;
        color: #B7791F;
    }

    .pill-shipping {
        background-color: #EBF8FF;
        color: #2B6CB0;
    }

    .pill-completed {
        background-color: #E6FFFA;
        color: #319795;
    }

    .pill-canceled {
        background-color: #FED7D7;
        color: #E53E3E;
    }

    .mini-product-tag {
        background-color: #F8F9FA;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 12px;
        margin-bottom: 4px;
        display: block;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0" style="color: #1E293B;">Quản Lý Đơn Đặt Hoa</h3>
            <small class="text-muted">Tiếp nhận, duyệt trạng thái và điều phối shipper giao hoa hỏa tốc</small>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["DangerMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["DangerMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card admin-order-card">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-admin-order w-100 m-0">
                    <thead>
                        <tr>
                            <th>Mã Đơn</th>
                            <th>Ngày Đặt</th>
                            <th>Thông Tin Khách Hàng</th>
                            <th>Sản Phẩm Gọi</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                            <th class="text-end">Hành Động Duyệt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            string pillClass = "pill-pending";
                            if (order.OrderStatus == "Đang giao") pillClass = "pill-shipping";
                            else if (order.OrderStatus == "Đã hoàn thành") pillClass = "pill-completed";
                            else if (order.OrderStatus == "Đã hủy") pillClass = "pill-canceled";

                            <tr>
                                <td class="fw-bold text-primary">#LAM-@order.Id</td>
                                <td class="text-muted">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="fw-bold text-dark">SĐT: @order.PhoneNumber</div>
                                    <small class="text-muted d-block text-truncate" style="max-width: 200px;" title="@order.ShippingAddress">
                                        <i class="bi bi-geo-alt-fill"></i> @order.ShippingAddress
                                    </small>
                                </td>
                                <td>
                                    @foreach (var detail in order.OrderDetails)
                                    {
                                        <span class="mini-product-tag">
                                            🌸 @(detail.Product?.Name ?? "Mẫu hoa hệ thống") <strong class="text-secondary">x@detail.Quantity</strong>
                                        </span>
                                    }
                                </td>
                                <td class="fw-bold text-dark">@order.TotalAmount.ToString("#,##0") đ</td>
                                <td>
                                    <span class="status-pill @pillClass">
                                        <i class="bi bi-circle-fill" style="font-size: 5px;"></i> @order.OrderStatus
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        @if (order.OrderStatus == "Chờ xử lý")
                                        {
                                            <form asp-area="Admin" asp-controller="OrderManager" asp-action="ApproveOrder" asp-route-orderId="@order.Id" method="post">
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold">
                                                    <i class="bi bi-shield-check"></i> Duyệt đơn
                                                </button>
                                            </form>

                                            <form asp-area="Admin" asp-controller="OrderManager" asp-action="CancelOrder" asp-route-orderId="@order.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    Hủy
                                                </button>
                                            </form>
                                        }
                                        else if (order.OrderStatus == "Đang giao")
                                        {
                                            <form asp-area="Admin" asp-controller="OrderManager" asp-action="CompleteOrder" asp-route-orderId="@order.Id" method="post">
                                                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                                    <i class="bi bi-patch-check-fill"></i> Hoàn thành
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">Không có thao tác</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-4 text-muted mb-2 d-block"></i>
                <p class="text-muted">Hệ thống chưa ghi nhận đơn đặt hoa nào từ khách hàng.</p>
            </div>
        }
    </div>
</div>