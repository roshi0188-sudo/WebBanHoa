@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Xác nhận khôi phục mật khẩu";
}

<div class="container my-5 py-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm p-4 p-md-5 bg-white rounded-4 text-center">
        <div class="mb-3 text-success fs-1">
            <i class="bi bi-envelope-check-fill" style="color: #319795;"></i>
        </div>
        <h4 class="fw-bold text-dark mb-3" style="font-family: 'Playfair Display', serif;">Yêu Cầu Đã Ghi Nhận</h4>
        <p class="text-muted small mb-4">
            Hệ thống đã phê duyệt mã Token bảo mật cấp lại mật khẩu dành cho tài khoản: <strong class="text-dark">@TempData["UserEmail"]</strong>
        </p>

        @if (TempData["ResetPasswordLink"] != null)
        {
            <div class="p-4 rounded-4 text-start border border-dashed mb-4 bg-light" style="border-color: #CBD5E1 !important;">
                <label class="small fw-bold text-secondary text-uppercase d-block mb-2"><i class="bi bi-bug-fill text-danger"></i> Liên kết khôi phục (Dành cho Demo Đồ án):</label>
                <p class="small text-break text-muted bg-white p-2.5 rounded-3 border select-all" style="font-family: monospace;">@TempData["ResetPasswordLink"]</p>
                <a href="@TempData["ResetPasswordLink"]" class="btn btn-sm text-white rounded-pill px-3 mt-1 fw-semibold" style="background-color: #834c58; border: none;">
                    Click vào đây để đặt lại Mật khẩu luôn <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
        }

        <p class="text-muted small">Trong môi trường thực tế, liên kết bảo mật an toàn trên sẽ được gửi kín vào hộp thư đến Email của khách hàng.</p>
    </div>
</div>