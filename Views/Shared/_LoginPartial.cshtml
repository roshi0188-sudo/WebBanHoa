@using Microsoft.AspNetCore.Identity
@using WebBanHoa.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-3">
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);

        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <div class="d-flex align-items-center gap-2">
                    <a asp-area="" asp-controller="Account" asp-action="Profile" class="position-relative p-0" title="Hồ sơ Admin">
                        <img src="@(string.IsNullOrEmpty(currentUser?.Avatar) ? "/images/avatar-admin.jpg" : currentUser.Avatar)"
                             class="rounded-circle object-fit-cover border border-2 border-danger shadow-sm"
                             style="width: 38px; height: 38px; transition: all 0.3s ease;" alt="Admin">
                        <span class="position-absolute bottom-0 end-0 bg-danger border border-light rounded-circle" style="width: 10px; height: 10px;"></span>
                    </a>
                    <a class="nav-link text-danger fw-bold p-0" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" style="font-size: 13px;">
                        Admin: @(currentUser?.FullName ?? User.Identity?.Name?.Split('@')[0])
                    </a>
                </div>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a class="nav-link p-0 profile-avatar-wrapper" asp-area="" asp-controller="Account" asp-action="Profile" title="Hồ sơ cá nhân">
                    <img src="@(string.IsNullOrEmpty(currentUser?.Avatar) ? "/images/avartar-user1.jpg" : currentUser.Avatar)"
                         class="rounded-circle object-fit-cover border border-2 shadow-sm"
                         style="width: 40px; height: 40px; border-color: #DE8F9F !important; transition: all 0.3s ease;"
                         alt="User"
                         onerror="this.src='https://api.dicebear.com/7.x/adventurer/svg?seed=@(User.Identity?.Name)'">
                </a>
            </li>
        }

        <li class="nav-item">
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" style="font-size: 12px; font-weight:600;">
                    <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
        <li class="nav-item"><a class="nav-link btn btn-outline-primary rounded-pill px-3 py-1" asp-controller="Account" asp-action="Login" style="font-size: 13px;">Đăng nhập</a></li>
    }
</ul>

<style>
    /* Hiệu ứng mượt mà */
    .profile-avatar-wrapper:hover img {
        transform: scale(1.1);
        filter: brightness(0.9);
    }

    /* Đảm bảo nav-link không bị vỡ bố cục */
    .navbar-nav .nav-link {
        white-space: nowrap;
        display: flex;
        align-items: center;
    }
</style>