@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container text-center py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 bg-white p-5 rounded-3 shadow-sm border">
            <i class="fas fa-exclamation-triangle text-danger display-1 mb-4"></i>
            <h2 class="fw-bold text-dark">TRUY CẬP BỊ TỪ CHỐI!</h2>
            <p class="text-muted my-3">Bạn không có quyền hạn quản trị để truy cập vào khu vực này. Vui lòng quay lại trang chủ hoặc đăng nhập bằng tài khoản cấp cao hơn.</p>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-warning px-4 py-2 rounded-pill fw-bold text-dark mt-3">
                <i class="fas fa-home me-2"></i>Quay lại Trang Chủ
            </a>
        </div>
    </div>
</div>