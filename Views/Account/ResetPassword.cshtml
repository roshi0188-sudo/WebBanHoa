@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Đặt lại mật khẩu mới";
}

<div class="container my-5 py-4" style="max-width: 500px;">

    @if (TempData["DangerMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 mb-4 shadow-sm" role="alert" style="background-color: #FFF5F5; color: #742A2A;">
            <i class="bi bi-exclamation-triangle-fill me-2" style="color: #E53E3E;"></i> @TempData["DangerMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm p-4 p-md-5 bg-white rounded-4">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark mb-2" style="font-family: 'Playfair Display', serif;">Mật Khẩu Mới</h3>
            <p class="text-muted small">Vui lòng thiết lập mật khẩu mới có độ dài từ 6 ký tự trở lên.</p>
        </div>

        <form asp-controller="Account" asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="userId" value="@ViewBag.UserId" />
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <div class="mb-3">
                <label class="form-label small fw-bold text-secondary text-uppercase">Mật khẩu mới</label>
                <input type="password" name="newPassword" class="form-control rounded-pill px-4 py-2.5" placeholder="Nhập mật khẩu mới..." required style="background-color: #FAFAFA; border: 1px solid #E2E8F0;" />
            </div>

            <div class="mb-4">
                <label class="form-label small fw-bold text-secondary text-uppercase">Xác nhận mật khẩu mới</label>
                <input type="password" name="confirmPassword" class="form-control rounded-pill px-4 py-2.5" placeholder="Nhập lại mật khẩu mới..." required style="background-color: #FAFAFA; border: 1px solid #E2E8F0;" />
            </div>

            <button type="submit" class="btn text-white w-100 rounded-pill py-2.5 fw-bold shadow-sm" style="background: linear-gradient(135deg, #DE8F9F, #A34863); border: none;">
                Xác nhận thay đổi mật khẩu
            </button>
        </form>
    </div>
</div>