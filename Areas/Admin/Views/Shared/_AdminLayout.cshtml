<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Floral LAM Admin</title>

    <!-- Nhúng font chữ cao cấp Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin-style.css" asp-append-version="true" />

    <style>
            /* Ép font chữ toàn trang admin sang Plus Jakarta Sans */
            *, h1, h2, h3, h4, h5, h6, p, span, small, a, input, select, button, textarea, td, th {
                font-family: 'Plus Jakarta Sans', sans-serif !important;
            }

            body {
                background-color: #F8FAFC;
                color: #1E293B;
                margin: 0;
                padding: 0;
            }

            /* SIDEBAR PREMIUM */
            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                width: 260px;
                background-color: #FFFFFF;
                border-right: 1px solid #E2E8F0;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 24px 16px;
                z-index: 100;
            }

            .logo-section {
                padding: 8px 12px 24px 12px;
                border-bottom: 1px solid #F1F5F9;
                margin-bottom: 20px;
            }

                .logo-section h4 {
                    color: #2D141A;
                    font-weight: 800;
                    font-size: 20px;
                    letter-spacing: -0.5px;
                    margin: 0;
                }

            /* NAVIGATION MENU */
            .nav-menu {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .nav-menu-item {
                margin-bottom: 6px;
                border-radius: 10px;
                transition: all 0.2s ease;
            }

            .nav-menu-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 14px;
                color: #64748B;
                text-decoration: none !important;
                font-weight: 600;
                font-size: 14px;
                border-radius: 10px;
                transition: all 0.25s ease;
            }

                .nav-menu-link i {
                    font-size: 18px;
                    color: #94A3B8;
                    transition: color 0.25s ease;
                }

            /* Hiệu ứng Hover */
            .nav-menu-item:hover .nav-menu-link {
                background-color: #F8FAFC;
                color: #A34863;
            }

                .nav-menu-item:hover .nav-menu-link i {
                    color: #A34863;
                }

            /* Trạng thái Active chuẩn Luxury */
            .nav-menu-item.active {
                background-color: #FAF4F6;
            }

                .nav-menu-item.active .nav-menu-link {
                    color: #A34863;
                    font-weight: 700;
                }

                    .nav-menu-item.active .nav-menu-link i {
                        color: #A34863;
                    }

            /* LOGOUT VÀ QUAY LẠI CỬA HÀNG */
            .logout-section {
                padding-top: 16px;
                border-top: 1px solid #F1F5F9;
            }

            .btn-return-store {
                background-color: #F8FAFC;
                color: #475569 !important;
                border: 1px solid #E2E8F0;
                justify-content: center;
                font-size: 13.5px;
            }

                .btn-return-store:hover {
                    background-color: #A34863 !important;
                    color: #FFFFFF !important;
                    border-color: #A34863;
                }

            /* MAIN CONTAINER ĐÃ CĂN CHỈNH KHOẢNG CÁCH */
            .main-container {
                margin-left: 260px;
                padding: 40px;
                min-height: 100vh;
                background-color: #F8FAFC;
            }
    </style>
</head>
<body>

    <!-- BẢO TRÌ SIDEBAR HỆ THỐNG -->
    <div class="sidebar">
        <div class="w-100">
            <div class="logo-section">
                <h4>🌸 Floral LAM Panel</h4>
            </div>

            <ul class="nav-menu">
                <!-- 1. DASHBOARD CHUNG -->
                <li class="nav-menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <a class="nav-menu-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard chung
                    </a>
                </li>

                <!-- 2. QUẢN LÝ SẢN PHẨM -->
                <li class="nav-menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ProductManager" ? "active" : "")">
                    <a class="nav-menu-link" asp-area="Admin" asp-controller="ProductManager" asp-action="Index">
                        <i class="bi bi-flower1"></i> Quản lý sản phẩm
                    </a>
                </li>

                <!-- 3. DANH MỤC HOA -->
                <li class="nav-menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" ? "active" : "")">
                    <a class="nav-menu-link" asp-area="Admin" asp-controller="Category" asp-action="Index">
                        <i class="bi bi-tags-fill"></i> Danh mục hoa
                    </a>
                </li>

                <!-- 4. QUẢN LÝ ĐƠN HÀNG -->
                <li class="nav-menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "OrderManager" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <a class="nav-menu-link" asp-area="Admin" asp-controller="OrderManager" asp-action="Index">
                        <i class="bi bi-clipboard-check-fill"></i> Quản lý đơn hàng
                    </a>
                </li>

                <!-- 5. DASHBOARD DOANH THU -->
                <li class="nav-menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "OrderManager" && ViewContext.RouteData.Values["Action"]?.ToString() == "RevenueDashboard" ? "active" : "")">
                    <a class="nav-menu-link" asp-area="Admin" asp-controller="OrderManager" asp-action="RevenueDashboard">
                        <i class="bi bi-graph-up-arrow"></i> Báo cáo doanh thu
                    </a>
                </li>

                <!-- 6. QUẢN LÝ NGƯỜI DÙNG -->
                <li class="nav-menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" && ViewContext.RouteData.Values["Action"]?.ToString() == "UserList" ? "active" : "")">
                    <a class="nav-menu-link" asp-area="Admin" asp-controller="Dashboard" asp-action="UserList">
                        <i class="bi bi-people-fill"></i> Quản lý người dùng
                    </a>
                </li>
            </ul>
        </div>

        <div class="logout-section">
            <a href="/" class="nav-menu-link btn-return-store d-flex align-items-center gap-2">
                <i class="bi bi-arrow-left-circle-fill"></i> Quay về Cửa hàng
            </a>
        </div>
    </div>

    <!-- KHU VỰC HIỂN THỊ NỘI DUNG CHÍNH -->
    <div class="main-container">
        @RenderBody()
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>