@model WebBanHoa.Models.ApplicationUser
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Hồ sơ cá nhân - Floral LAM";
}

<style>
    :root {
        --primary-luxury: #A34863;
        --secondary-pastel: #DE8F9F;
        --dark-slate: #2D3748;
        --light-neutral: #FAFAFA;
        --border-color: #E2E8F0;
    }

    /* Khung card tổng thể phong cách Boutique */
    .premium-profile-container {
        background: white;
        border-radius: 32px;
        border: none;
        box-shadow: 0 20px 50px rgba(163, 72, 99, 0.04);
        overflow: hidden;
        transition: all 0.4s ease;
    }

    /* Phân vùng ảnh đại diện bên trái */
    .avatar-sidebar {
        background: linear-gradient(145deg, #FFF5F7 0%, #FAF8FA 100%);
        padding: 60px 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-right: 1px solid #F3EAEF;
    }

    /* Vùng chứa ảnh đại diện tương tác */
    .avatar-wrapper {
        position: relative;
        width: 140px;
        height: 140px;
        border-radius: 50%;
        padding: 6px;
        background: linear-gradient(135deg, var(--secondary-pastel), var(--primary-luxury));
        box-shadow: 0 10px 25px rgba(163, 72, 99, 0.15);
    }

    .avatar-main {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid white;
        background-color: white;
    }

    /* Nút camera đè lên avatar khi sửa */
    .avatar-overlay-btn {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: rgba(45, 55, 72, 0.4);
        backdrop-filter: blur(2px);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .avatar-wrapper:hover .avatar-overlay-btn.active-mode {
        opacity: 1;
    }

    /* Phân vùng thông tin bên phải */
    .profile-info-body {
        padding: 50px;
    }

    .info-section-title {
        font-family: 'Playfair Display', serif;
        color: var(--dark-slate);
        font-weight: 700;
        font-size: 24px;
        letter-spacing: -0.5px;
    }

    /* Thiết kế trường thông tin dạng hàng ngang Luxury */
    .luxury-info-row {
        padding: 16px 0;
        border-bottom: 1px solid #F8F1F4;
        transition: all 0.3s ease;
    }

    .luxury-info-label {
        font-size: 12px;
        font-weight: 700;
        color: #A0AEC0;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 4px;
    }

    .luxury-info-value {
        font-size: 16px;
        font-weight: 600;
        color: var(--dark-slate);
    }

    /* Inputs tùy chỉnh khi ở chế độ chỉnh sửa */
    .luxury-input-field {
        background-color: var(--light-neutral);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 12px 20px;
        font-size: 15px;
        font-weight: 500;
        color: var(--dark-slate);
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

        .luxury-input-field:focus {
            background-color: white;
            border-color: var(--secondary-pastel);
            box-shadow: 0 0 0 4px rgba(222, 143, 159, 0.12);
            outline: none;
        }

    /* Thiết kế hệ thống nút tương tác */
    .btn-edit-trigger {
        border: 1px solid var(--primary-luxury);
        color: var(--primary-luxury);
        background: transparent;
        border-radius: 30px;
        padding: 12px 35px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.3s ease;
    }

        .btn-edit-trigger:hover {
            background: #FFF5F7;
            color: var(--primary-luxury);
            transform: translateY(-1px);
        }

    .btn-save-luxury {
        background: linear-gradient(135deg, var(--secondary-pastel), var(--primary-luxury));
        color: white;
        border: none;
        border-radius: 30px;
        padding: 12px 35px;
        font-weight: 600;
        font-size: 14px;
        box-shadow: 0 8px 20px rgba(163, 72, 99, 0.15);
        transition: all 0.3s ease;
    }

        .btn-save-luxury:hover {
            opacity: 0.95;
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(163, 72, 99, 0.25);
        }

    .btn-cancel-luxury {
        background-color: #EDF2F7;
        color: #718096;
        border: none;
        border-radius: 30px;
        padding: 12px 30px;
        font-weight: 500;
        font-size: 14px;
        transition: all 0.3s ease;
    }

        .btn-cancel-luxury:hover {
            background-color: #E2E8F0;
            color: #4A5568;
        }
</style>

<div class="container my-5 py-4" style="max-width: 950px;">

    <!-- Hệ thống thông báo trạng thái nổi phía trên -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 mb-4 shadow-sm" role="alert" style="background-color: #E6FFFA; color: #234E52;">
            <i class="bi bi-check-circle-fill me-2" style="color: #319795;"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["DangerMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 mb-4 shadow-sm" role="alert" style="background-color: #FFF5F5; color: #742A2A;">
            <i class="bi bi-exclamation-triangle-fill me-2" style="color: #E53E3E;"></i> @TempData["DangerMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card premium-profile-container">
        <!-- FORM GỬI DỮ LIỆU ĐỒNG BỘ -->
        <form asp-controller="Account" asp-action="EditProfile" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="row g-0">
                <!-- CỘT TRÁI: AVATAR SIDEBAR -->
                <div class="col-md-4 avatar-sidebar text-center">
                    <div class="avatar-wrapper">
                        <!-- 🟢 ĐÃ ĐỒNG BỘ: Đổi Model.Avatar thành Model.AvatarUrl để khớp hoàn toàn cấu trúc Database -->
                        <img id="avatarPreviewImage" src="@(string.IsNullOrEmpty(Model.Avatar) ? "/images/default-avatar.png" : Model.Avatar)"
                             class="avatar-main" onerror="this.src='https://api.dicebear.com/7.x/adventurer/svg?seed=@Model.UserName'">

                        <!-- Nút camera phủ mờ khi hovering -->
                        <label for="avatarFileInput" class="avatar-overlay-btn" id="avatarEditBtn">
                            <i class="bi bi-camera-fill fs-4"></i>
                        </label>
                        <input type="file" id="avatarFileInput" name="avatarFile" class="d-none" accept="image/*" onchange="previewAvatar(this)" />
                    </div>

                    <h4 class="fw-bold mt-4 mb-1" style="color: var(--dark-slate); font-family: 'Plus Jakarta Sans', sans-serif;">@Model.UserName</h4>
                    <span class="badge rounded-pill px-3 py-1.5 mt-1" style="background-color: #FFF5F7; color: var(--primary-luxury); font-size: 12px; font-weight: 600;">
                        @(User.IsInRole("Admin") ? "Quản trị viên" : "Thành viên Boutique")
                    </span>
                </div>

                <!-- CỘT PHẢI: CHI TIẾT THÔNG TIN TÀI KHOẢN -->
                <div class="col-md-8 profile-info-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="info-section-title m-0">Thông Tin Tài Khoản</h5>
                            <i class="bi bi-flower1 fs-4" style="color: var(--secondary-pastel);"></i>
                        </div>

                        <!-- HỌ VÀ TÊN -->
                        <div class="luxury-info-row">
                            <div class="luxury-info-label">Họ và tên người dùng</div>
                            <div id="viewFullName" class="luxury-info-value">@(Model.FullName ?? "Chưa cập nhật họ tên")</div>
                            <div id="editFullNameContainer" class="d-none mt-2">
                                <input type="text" name="fullName" id="editFullName" class="form-control luxury-input-field w-100" value="@Model.FullName" placeholder="Nhập họ và tên đầy đủ..." />
                            </div>
                        </div>

                        <!-- SỐ ĐIỆN THOẠI -->
                        <div class="luxury-info-row">
                            <div class="luxury-info-label">Số điện thoại liên hệ</div>
                            <div id="viewPhoneNumber" class="luxury-info-value">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cung cấp số điện thoại" : Model.PhoneNumber)</div>
                            <div id="editPhoneNumberContainer" class="d-none mt-2">
                                <input type="tel" name="phoneNumber" id="editPhoneNumber" class="form-control luxury-input-field w-100" value="@Model.PhoneNumber" placeholder="Nhập số điện thoại nhận hoa..." />
                            </div>
                        </div>

                        <!-- ĐỊA CHỈ MẶC ĐỊNH -->
                        <div class="luxury-info-row">
                            <div class="luxury-info-label">Địa chỉ giao nhận mặc định</div>
                            <div id="viewAddress" class="luxury-info-value" style="line-height: 1.6;">@(string.IsNullOrEmpty(Model.Address) ? "Chưa lưu địa chỉ giao hoa mặc định" : Model.Address)</div>
                            <div id="editAddressContainer" class="d-none mt-2">
                                <textarea name="address" id="editAddress" class="form-control luxury-input-field w-100" rows="3" placeholder="Ghi rõ số nhà, tên đường, quận/huyện..."></textarea>
                            </div>
                        </div>

                        <!-- MAIL HỆ THỐNG -->
                        <div class="luxury-info-row border-0">
                            <div class="luxury-info-label">Địa chỉ Email liên kết</div>
                            <div class="luxury-info-value text-muted" style="font-weight: 500;">@Model.Email</div>
                        </div>
                    </div>

                    <!-- KHU VỰC CỤM NÚT ĐIỀU HƯỚNG TƯƠNG TÁC -->
                    <div class="mt-5 pt-3 border-top text-end">
                        <!-- Nút hiển thị ở chế độ Xem -->
                        <div id="viewActionGroup" class="d-inline-flex gap-2">
                            @if (User.IsInRole("Admin"))
                            {
                                <!-- 🟢 ĐẶC QUYỀN ADMIN: Thêm nút quay nhanh về Dashboard quản trị -->
                                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-light rounded-pill px-4 text-decoration-none fw-semibold d-inline-flex align-items-center gap-1" style="font-size: 14px; color: #DC3545 !important; border-color: #F5C2C7; background-color: #FFF5F5;">
                                    <i class="bi bi-shield-lock-fill"></i> Vào trang Quản trị
                                </a>
                            }

                            <button type="button" id="btnSwitchToEdit" class="btn btn-edit-trigger" onclick="toggleEditMode(true)">
                                <i class="bi bi-pencil-square me-2"></i> Thay đổi thông tin
                            </button>
                        </div>

                        <!-- Cặp nút xuất hiện ở chế độ Sửa -->
                        <div id="editActionGroup" class="d-none gap-3 justify-content-end">
                            <button type="button" class="btn btn-cancel-luxury" onclick="toggleEditMode(false)">Hủy bỏ</button>
                            <button type="submit" class="btn btn-save-luxury shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Lưu lại thay đổi
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form> <div class="row g-0 border-top" style="border-color: #F3EAEF !important;">
            <div class="col-md-4 bg-light/30 p-4 d-flex flex-column justify-content-center border-end" style="border-color: #F3EAEF !important;">
                <h6 class="fw-bold mb-1" style="color: var(--dark-slate);"><i class="bi bi-key-fill text-secondary me-1"></i> Bảo mật tài khoản</h6>
                <p class="text-muted small m-0" style="font-size: 12px; line-height: 1.5;">Bạn nên định kỳ thay đổi mật khẩu có độ dài trên 6 ký tự để nâng cao tính an toàn bảo mật cho tài khoản cá nhân.</p>
            </div>

            <div class="col-md-8 p-4">
                <button type="button" id="btnExpandPassword" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold mb-2" onclick="togglePasswordForm(true)" style="font-size: 13px;">
                    <i class="bi bi-shield-lock me-1"></i> Yêu cầu đổi mật khẩu mới
                </button>

                <div id="passwordFormContainer" class="d-none card border-0 p-3 rounded-4 bg-light/40 mt-2">
                    <form asp-controller="Account" asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="luxury-info-label d-block">Mật khẩu hiện tại</label>
                            <input type="password" name="currentPassword" class="form-control luxury-input-field w-100" placeholder="Nhập mật khẩu đang sử dụng..." required />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="luxury-info-label d-block">Mật khẩu mới</label>
                                <input type="password" name="newPassword" class="form-control luxury-input-field w-100" placeholder="Tối thiểu 6 ký tự..." required />
                            </div>
                            <div class="col-sm-6">
                                <label class="luxury-info-label d-block">Xác nhận mật khẩu mới</label>
                                <input type="password" name="confirmPassword" class="form-control luxury-input-field w-100" placeholder="Nhập lại mật khẩu mới..." required />
                            </div>
                        </div>

                        <div class="text-end space-x-2 mt-3">
                            <button type="button" class="btn btn-sm btn-cancel-luxury py-1.5 px-3" onclick="togglePasswordForm(false)">Hủy bỏ</button>
                            <button type="submit" class="btn btn-sm btn-save-luxury py-1.5 px-4" style="border-radius: 20px;">
                                <i class="bi bi-shield-check me-1"></i> Cập nhật mật khẩu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Logic chuyển đổi mượt mà giữa chế độ Xem và chế độ Chỉnh sửa
        function toggleEditMode(isEdit) {
            const cameraBtn = document.getElementById('avatarEditBtn');

            if (isEdit) {
                // Ẩn text tĩnh và cụm nút xem, hiển thị Form nhập liệu
                document.getElementById('viewFullName').classList.add('d-none');
                document.getElementById('editFullNameContainer').classList.remove('d-none');
                document.getElementById('viewPhoneNumber').classList.add('d-none');
                document.getElementById('editPhoneNumberContainer').classList.remove('d-none');
                document.getElementById('viewAddress').classList.add('d-none');
                document.getElementById('editAddressContainer').classList.remove('d-none');

                document.getElementById('viewActionGroup').classList.add('d-none');
                document.getElementById('editActionGroup').classList.replace('d-none', 'd-flex');

                // Kích hoạt lớp phủ chỉnh sửa ảnh đại diện
                cameraBtn.classList.add('active-mode');
                // Gán ngược dữ liệu text diện rộng vào textarea phòng lỗi đồng bộ HTML
                document.getElementById('editAddress').value = `@Html.Raw(Model.Address)`;
            } else {
                // Quay lại chế độ hiển thị tĩnh ban đầu
                document.getElementById('viewFullName').classList.remove('d-none');
                document.getElementById('editFullNameContainer').classList.add('d-none');
                document.getElementById('viewPhoneNumber').classList.remove('d-none');
                document.getElementById('editPhoneNumberContainer').classList.add('d-none');
                document.getElementById('viewAddress').classList.remove('d-none');
                document.getElementById('editAddressContainer').classList.add('d-none');

                document.getElementById('viewActionGroup').classList.remove('d-none');
                document.getElementById('editActionGroup').classList.replace('d-flex', 'd-none');

                cameraBtn.classList.remove('active-mode');
                // Trả lại ảnh gốc ban đầu nếu khách bấm hủy sau khi chọn file nhầm
                document.getElementById('avatarPreviewImage').src = `@(string.IsNullOrEmpty(Model.Avatar) ? "/images/default-avatar.png" : Model.Avatar)`;
            }
        }

        // 2. JavaScript render nhanh ảnh đại diện (Preview) lập tức khi vừa nạp file
        function previewAvatar(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('avatarPreviewImage').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // 3. Logic ẩn/hiện hộp thoại biểu mẫu Đổi mật khẩu bảo mật
        function togglePasswordForm(showForm) {
            const container = document.getElementById('passwordFormContainer');
            const triggerBtn = document.getElementById('btnExpandPassword');

            if (showForm) {
                container.classList.remove('d-none');
                triggerBtn.classList.add('d-none');
            } else {
                container.classList.add('d-none');
                triggerBtn.classList.remove('d-none');

                // Reset xóa sạch các chữ đang gõ dở trong ô input mật khẩu khi bấm hủy
                container.querySelectorAll('input').forEach(input => input.value = '');
            }
        }
    </script>
}