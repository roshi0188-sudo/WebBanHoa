@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quên mật khẩu - Floral LAM";
}

<div class="container my-5 py-4" style="max-width: 500px;">
    <div class="card border-0 shadow-sm p-4 p-md-5 bg-white rounded-4">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark mb-2" style="font-family: 'Playfair Display', serif;">Quên Mật Khẩu?</h3>
            <p class="text-muted small">Nhập email liên kết với tài khoản của bạn để nhận liên kết khôi phục.</p>
        </div>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger small mb-3 fw-medium"></div>

            <div class="mb-4">
                <label class="form-label small fw-bold text-secondary text-uppercase" style="letter-spacing: 0.5px;">Địa chỉ Email</label>
                <div class="position-relative">
                    <input type="email" name="email" class="form-control rounded-pill px-4 py-2.5" placeholder="example@floral.com" required style="background-color: #FAFAFA; border: 1px solid #E2E8F0;" />
                </div>
            </div>

            <button type="submit" class="btn text-white w-100 rounded-pill py-2.5 fw-bold shadow-sm" style="background: linear-gradient(135deg, #DE8F9F, #A34863); border: none;">
                Gửi liên kết khôi phục
            </button>

            <div class="text-center mt-4">
                <a asp-action="Login" class="text-decoration-none small fw-semibold" style="color: #A34863;">
                    <i class="bi bi-arrow-left"></i> Quay lại Đăng nhập
                </a>
            </div>
        </form>
    </div>
</div>