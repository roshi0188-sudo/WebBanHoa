@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center py-5">
            <div class="card border-0 shadow-sm p-5 bg-white rounded-4">
                <div class="text-danger mb-4">
                    <i class="bi bi-exclamation-triangle-fill display-1"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">Đã xảy ra lỗi hệ thống!</h2>
                <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
                    Yêu cầu xử lý dữ liệu của bạn tạm thời không thể hoàn thành. Vui lòng quay lại hoặc liên hệ quản trị viên để kiểm tra lại luồng kết nối cơ sở dữ liệu.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/Admin/Dashboard" class="btn px-4 py-2 fw-semibold text-white shadow-sm"
                       style="background: linear-gradient(135deg, #DE8F9F, #A34863); border: none; border-radius: 20px;">
                        <i class="bi bi-house-door me-2"></i> Quay về Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>