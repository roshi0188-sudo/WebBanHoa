<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Floral LAM Admin</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-luxury: #A34863;
            --secondary-pastel: #DE8F9F; 
            --dark-slate: #2D3748; 
            --light-neutral: #FAF8FA; 
            --border-soft: #F3EAEF; 
        }

        * {
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: #FBF9FB;
            color: var(--dark-slate);
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #FFFFFF;
            border-right: 1px solid var(--border-soft);
            padding: 35px 22px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            z-index: 9999 !important;
            pointer-events: auto !important;
            box-shadow: 4px 0 25px rgba(163, 72, 99, 0.01);
        }

        .logo-section h4 {
            color: var(--primary-luxury);
            font-weight: 800;
            font-size: 22px;
            letter-spacing: -0.5px;
            margin-bottom: 35px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
        }

        .nav-menu-item {
            margin-bottom: 6px;
        }

        .nav-menu-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 18px;
            color: #718096;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            border-radius: 14px;
            transition: all 0.25s ease;
        }

            /* Hiệu ứng Hover chuyển màu nhẹ dịu mắt */
            .nav-menu-link:hover {
                background-color: #FFF5F7;
                color: var(--primary-luxury);
            }

        /* Khối kích hoạt phân hệ chủ đạo tự động (Active State) */
        .nav-menu-item.active .nav-menu-link {
            background-color: #FFF5F7;
            color: var(--primary-luxury);
            font-weight: 700;
            border-left: 4px solid var(--primary-luxury);
            border-radius: 0 14px 14px 0;
            padding-left: 14px;
        }

        /* Nút quay về giao diện khách hàng phía dưới */
        .btn-return-store {
            background-color: var(--primary-luxury);
            color: white !important;
            font-weight: 600;
            font-size: 13px;
            text-align: center;
            justify-content: center;
            border-radius: 25px;
            padding: 11px 20px;
            box-shadow: 0 4px 12px rgba(131, 76, 88, 0.15);
            transition: all 0.3s ease;
        }

            .btn-return-store:hover {
                opacity: 0.95;
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(131, 76, 88, 0.25);
            }


        .main-container {
            margin-left: 260px;
            padding: 40px 50px;
            min-height: 100vh;
            position: relative;
            z-index: 1;
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="w-100">
            <div class="logo-section">
                <h4>🌸 Floral LAM</h4>
            </div>

            <ul class="nav-menu">
                <li class="nav-menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <a class="nav-menu-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard
                    </a>
                </li>

                <li class="nav-menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ProductManager" ? "active" : "")">
                    <a class="nav-menu-link" asp-area="Admin" asp-controller="ProductManager" asp-action="Index">
                        <i class="bi bi-flower1"></i> Quản lý sản phẩm
                    </a>
                </li>

                <li class="nav-menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" ? "active" : "")">
                    <a class="nav-menu-link" asp-area="Admin" asp-controller="Category" asp-action="Index">
                        <i class="bi bi-tags-fill"></i> Danh mục hoa
                    </a>
                </li>

                <li class="nav-menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "OrderManager" ? "active" : "")">
                    <a class="nav-menu-link" asp-area="Admin" asp-controller="OrderManager" asp-action="Index">
                        <i class="bi bi-clipboard-check-fill"></i>Quản lý đơn hàng
                    </a>
                </li>
            </ul>
        </div>

        <div class="logout-section">
            <a href="/" class="nav-menu-link btn-return-store d-flex align-items-center gap-2">
                <i class="bi bi-arrow-left-circle-fill"></i> Quay lại Cửa hàng
            </a>
        </div>
    </div>

    <div class="main-container">
        @RenderBody()
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>