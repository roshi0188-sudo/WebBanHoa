@model WebBanHoa.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
    }

    .register-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    }

    .btn-orange {
        background-color: #FF34B3;
        color: white;
        border: none;
        transition: background-color 0.2s;
    }

        .btn-orange:hover {
            background-color: #FF34B3;
            color: white;
        }

    .text-orange {
        color: #FF34B3 !important;
    }

    .form-control:focus {
        border-color: #FF34B3;
        box-shadow: 0 0 0 0.25rem rgba(255, 52, 179, 0.25);
    }
</style>

<div class="container mt-4 py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="register-card p-5">
                <div class="text-center mb-4">
                    <span class="display-5">🌸</span>
                    <h3 class="fw-bold text-dark">Floral Lam</h3>
                    <p class="text-muted small">Tạo tài khoản mới để mua hoa nhé</p>
                </div>

                <form asp-controller="Account" asp-action="Register" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold text-secondary">Họ và tên</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-user"></i></span>
                            <input asp-for="FullName" class="form-control border-start-0 bg-light" placeholder="Nhập họ và tên của bạn..." />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary">Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0 bg-light" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control border-start-0 bg-light" placeholder="Nhập mật khẩu (tối thiểu 6 ký tự)..." />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary">Xác nhận mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-check-double"></i></span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 bg-light" placeholder="Nhập lại mật khẩu..." />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-orange w-100 py-2.5 rounded-3 fw-bold shadow-sm">Đăng ký</button>
                </form>

                <div class="text-center mt-4">
                    <p class="small text-muted mb-0">Đã có tài khoản? <a asp-action="Login" class="text-decoration-none text-orange fw-medium">Đăng nhập ngay</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}